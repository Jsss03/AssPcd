from datetime import datetime

# Get current system time
now = datetime.now()

# Format it nicely: Day, Month Date, Year, Time
print("Current Date/Time:", now.strftime("%A, %B %d, %Y %H:%M %p"))


import urllib.request
import random

def get_weather_info(city):
    try:
        # Try real-time internet first
        url = f"https://wttr.in/{city}?format=%C+%t"
        with urllib.request.urlopen(url, timeout=3) as response:
            data = response.read().decode('utf-8')
            print(f"Live Weather {city}: {data}")
    except:
        # If internet fails, use this so the program doesn't stop!
        print("Weather: [Status Offline] - Using Default Forecast (Sunny 30°C)")

        


