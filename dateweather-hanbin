# --- 2. WEATHER DASHBOARD FUNCTION ---
def get_weather_dashboard(city="Kajang"):
    """
    Fetches real-time weather and simplifies it into 5 categories:
    Sunny, Cloudy, Light Rain, Heavy Rain, or Windy.
    """
    # Mapping professional API codes to your 5 simple words
    weather_map = {
        0: "Sunny", 
        1: "Cloudy", 2: "Cloudy", 3: "Cloudy",
        51: "Light Rain", 61: "Light Rain", 80: "Light Rain",
        65: "Heavy Rain", 82: "Heavy Rain"
    }

    try:
        # Step A: Get Coordinates (Latitude & Longitude)
        geo_url = f"https://geocoding-api.open-meteo.com/v1/search?name={city}&count=1"
        geo_data = requests.get(geo_url, timeout=5).json()
        
        if "results" not in geo_data:
            raise Exception("City not found")
            
        lat = geo_data["results"][0]["latitude"]
        lon = geo_data["results"][0]["longitude"]

        # Step B: Get Weather Data using coordinates
        url = "https://api.open-meteo.com/v1/forecast"
        params = {
            "latitude": lat, 
            "longitude": lon, 
            "current_weather": True, 
            "windspeed_unit": "kmh"
        }
        res = requests.get(url, params=params, timeout=5).json()

        # Step C: Extract and Simplify
        code = res["current_weather"]["weathercode"]
        wind = res["current_weather"]["windspeed"]
        temp = res["current_weather"]["temperature"]
        
        # Logic for your 5 categories
        if wind > 30:
            condition = "Windy"
        else:
            condition = weather_map.get(code, "Sunny")

        # --- THE OUTPUT BOX ---
        print("\n" + "═"*35)
        print(f"  🌍 LIVE STATUS : {city.upper()}")
        print(f"  ☁️  CONDITION  : {condition}")
        print(f"  🌡️  TEMP       : {temp}°C")
        print("═"*35 + "\n")

        return condition

    except Exception:
        # Fallback: If internet is blocked, use a random one so the program keeps running
        sim_conditions = ["Sunny", "Cloudy", "Light Rain"]
        sim_weather = random.choice(sim_conditions)
        print("\n[!] Connection Issue: Showing Simulated Weather")
        print(f"  ☁️  CONDITION  : {sim_weather} (Simulated)")
        print("-" * 35 + "\n")
        return sim_weather

# --- 4. PREVENT AUTO-CLOSE ---
if __name__ == "__main__":
    get_weather_dashboard("Kajang")
    input("\nPress Enter to exit...") # <--- ADD THIS LINE!
