import requests
from datetime import datetime

def get_weather_dashboard(city="Cheras"):
    weather_map = {
        0: "Sunny", 1: "Cloudy", 2: "Cloudy", 3: "Cloudy",
        51: "Light Rain", 61: "Light Rain", 80: "Light Rain",
        65: "Heavy Rain", 82: "Heavy Rain"
    }
    
    # Get Current Date and Time
    now = datetime.now()
    dt_str = now.strftime("%d-%m-%Y | %H:%M %p")

    try:
        # Get Weather (Same logic as before)
        geo_url = f"https://geocoding-api.open-meteo.com/v1/search?name={city}&count=1"
        geo_data = requests.get(geo_url, timeout=5).json()
        lat, lon = geo_data["results"][0]["latitude"], geo_data["results"][0]["longitude"]

        url = "https://api.open-meteo.com/v1/forecast"
        params = {"latitude": lat, "longitude": lon, "current_weather": True}
        res = requests.get(url, params=params, timeout=5).json()
        
        temp = res["current_weather"]["temperature"]
        condition = weather_map.get(res["current_weather"]["weathercode"], "Sunny")

        # --- TWO-COLUMN DASHBOARD ---
        print("=" * 60)
        
        # COLUMN 1: TIME (Left) & LOCATION (Right)
        # We give the time 30 spaces so the Location always starts at the same spot
        time_text = f"📅 {dt_str}"
        city_text = f"📍{city.upper()}"
        print(f"  {time_text:<30} {city_text}")
        
        # COLUMN 2: TEMP (Left) & CONDITION (Right)
        temp_text = f"🌡 TEMP: {temp}°C"
        cond_text = f"☁ CONDITION: {condition}"
        print(f"  {temp_text:<20} {cond_text}")
        
        print("=" * 60)
        

        return condition

    except:
        print("="*60)
        print(f" 📅 {dt_str}   📍 {city.upper()} [OFFLINE]")
        print("="*60)
        return "Sunny"

