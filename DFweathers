from datetime import datetime
import requests

# PART 1: The "Internet" part (Run this only once at the very start of main.py)
def get_weather_data(city="Cheras"):
    weather_map = {
        0: "Sunny", 1: "Cloudy", 2: "Cloudy", 3: "Cloudy",
        51: "Light Rain", 61: "Light Rain", 80: "Light Rain",
        65: "Heavy Rain", 82: "Heavy Rain"
    }
    try:
        # Get Coordinates
        geo_url = f"https://geocoding-api.open-meteo.com/v1/search?name={city}&count=1"
        geo_data = requests.get(geo_url, timeout=5).json()
        lat, lon = geo_data["results"][0]["latitude"], geo_data["results"][0]["longitude"]

        # Get Weather
        url = "https://api.open-meteo.com/v1/forecast"
        params = {"latitude": lat, "longitude": lon, "current_weather": True}
        res = requests.get(url, params=params, timeout=5).json()

        temp = res["current_weather"]["temperature"]
        condition = weather_map.get(res["current_weather"]["weathercode"], "Sunny")

        # RETURN a dictionary so main.py can save it
        return {"temp": temp, "cond": condition, "city": city}
    except:
        return {"temp": "N/A", "cond": "Sunny", "city": city}

# PART 2: The "Printing" part (Run this every time the menu loops)
def display_dashboard(data):
    now = datetime.now()
    dt_str = now.strftime("%d-%m-%Y | %I:%M %p")
    width = 60

    print("=" * width)
    # Row 1: Date & Time
    print(f"{f'📅  {dt_str}':^60}")
    # Row 2: Location
    print(f"{f'📍  {data['city'].upper()}':^60}")
    # Row 3: Temp
    print(f"{f'🌡️  TEMP: {data['temp']}°C':^60}")
    # Row 4: Condition
    print(f"{f'☁️  CONDITION: {data['cond']}':^60}")


